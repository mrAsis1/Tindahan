# Explicitly select local demo or Supabase. A broken Supabase configuration must
# never silently save customer records to the local demo instead.
VITE_DATA_BACKEND=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only use the public publishable key (sb_publishable_...), never a secret or
# service-role key. All VITE_ values are visible to anyone using the application.
